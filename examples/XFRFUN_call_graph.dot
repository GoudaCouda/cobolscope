digraph "XFRFUN_CallGraph" {
    // Global Graph Attributes
    rankdir=TB;
    compound=true;
    splines=spline;
    nodesep=0.45;
    ranksep=0.75;
    ratio=auto;
    bgcolor="#FFFFFF";
    fontname="Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, Helvetica, Arial, sans-serif";
    fontsize=12;

    // Top-Level Program Header Title
    labelloc="t";
    labeljust="c";
    label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="3"><tr><td><font point-size="15" color="#0F172A"><b>Procedure Call Graph: XFRFUN</b></font></td></tr><tr><td><font point-size="9" color="#64748B">10 Procedures | 14 Calls &amp; Transfers | Max Depth: 5</font></td></tr></table>>;

    node [fontname="Segoe UI, Helvetica, Arial, sans-serif", fontsize=10, shape=box, style="filled,rounded", penwidth=1.5, margin="0.15,0.08"];
    edge [fontname="Segoe UI, Helvetica, Arial, sans-serif", fontsize=8, arrowsize=0.75];

    subgraph "cluster_0_cluster_main_driver" {
        label="Main Control &amp; Driver";
        style="filled,rounded";
        color="#1A365D";
        fillcolor="#EBF4FF";
        fontcolor="#1A365D";
        fontsize=11;
        penwidth=1.5;

        p_PREMIERE [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="2"><tr><td align="center" bgcolor="#0078D4" cellpadding="3"><font color="#FFFFFF" point-size="9"><b>&#9654; START / ENTRY POINT</b></font></td></tr><tr><td align="center" cellpadding="2"><b><font point-size="11">PREMIERE</font></b></td></tr><tr><td align="center" cellpadding="1"><font color="#64748B" point-size="8">L488-524 | 14 stmts | CC:2</font></td></tr><tr><td align="center" cellpadding="1"><font color="#5C2D91" point-size="8"><b>[SQL:1 | +1 exit]</b></font></td></tr></table>>, fillcolor="#FFFFFF", color="#0078D4", penwidth=2.5, tooltip="[START] PREMIERE (Lines 488-524)"];
    }

    subgraph "cluster_1_cluster_file_io" {
        label="File I/O Operations";
        style="filled,rounded";
        color="#107C41";
        fillcolor="#F2F9F4";
        fontcolor="#0B5A2F";
        fontsize=11;
        penwidth=1.5;

        p_WRITE_TO_PROCTRAN [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="2"><tr><td align="center" cellpadding="2"><b><font point-size="11">WRITE-TO-PROCTRAN</font></b></td></tr><tr><td align="center" cellpadding="1"><font color="#64748B" point-size="8">L1782-1787 | 2 stmts | CC:1</font></td></tr><tr><td align="center" cellpadding="1"><font color="#5C2D91" point-size="8"><b>[+1 exit]</b></font></td></tr></table>>, fillcolor="#FFFFFF", color="#107C41", penwidth=1.5, tooltip="WRITE-TO-PROCTRAN (Lines 1782-1787)"];
    }

    subgraph "cluster_2_cluster_database_io" {
        label="Database &amp; Subsystem Access";
        style="filled,rounded";
        color="#008272";
        fillcolor="#F0FDFB";
        fontcolor="#005A4E";
        fontsize=11;
        penwidth=1.5;

        p_UPDATE_ACCOUNT_DB2 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="2"><tr><td align="center" cellpadding="2"><b><font point-size="11">UPDATE-ACCOUNT-DB2</font></b></td></tr><tr><td align="center" cellpadding="1"><font color="#64748B" point-size="8">L527-1135 | 161 stmts | CC:15</font></td></tr><tr><td align="center" cellpadding="1"><font color="#5C2D91" point-size="8"><b>[SQL:34 | +1 exit]</b></font></td></tr></table>>, fillcolor="#FFFFFF", color="#008272", penwidth=1.5, tooltip="UPDATE-ACCOUNT-DB2 (Lines 527-1135)"];
        p_UPDATE_ACCOUNT_DB2_FROM [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="2"><tr><td align="center" cellpadding="2"><b><font point-size="11">UPDATE-ACCOUNT-DB2-FROM</font></b></td></tr><tr><td align="center" cellpadding="1"><font color="#64748B" point-size="8">L1138-1257 | 24 stmts | CC:4</font></td></tr><tr><td align="center" cellpadding="1"><font color="#5C2D91" point-size="8"><b>[SQL:2 | +1 exit]</b></font></td></tr></table>>, fillcolor="#FFFFFF", color="#008272", penwidth=1.5, tooltip="UPDATE-ACCOUNT-DB2-FROM (Lines 1138-1257)"];
        p_UPDATE_ACCOUNT_DB2_TO [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="2"><tr><td align="center" cellpadding="2"><b><font point-size="11">UPDATE-ACCOUNT-DB2-TO</font></b></td></tr><tr><td align="center" cellpadding="1"><font color="#64748B" point-size="8">L1260-1779 | 136 stmts | CC:17</font></td></tr><tr><td align="center" cellpadding="1"><font color="#5C2D91" point-size="8"><b>[SQL:25 | +1 exit]</b></font></td></tr></table>>, fillcolor="#FFFFFF", color="#008272", penwidth=1.5, tooltip="UPDATE-ACCOUNT-DB2-TO (Lines 1260-1779)"];
        p_WRITE_TO_PROCTRAN_DB2 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="2"><tr><td align="center" cellpadding="2"><b><font point-size="11">WRITE-TO-PROCTRAN-DB2</font></b></td></tr><tr><td align="center" cellpadding="1"><font color="#64748B" point-size="8">L1790-2087 | 79 stmts | CC:3</font></td></tr><tr><td align="center" cellpadding="1"><font color="#5C2D91" point-size="8"><b>[SQL:12 | +1 exit]</b></font></td></tr></table>>, fillcolor="#FFFFFF", color="#008272", penwidth=1.5, tooltip="WRITE-TO-PROCTRAN-DB2 (Lines 1790-2087)"];
        p_CHECK_FOR_STORM_DRAIN_DB2 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="2"><tr><td align="center" cellpadding="2"><b><font point-size="11">CHECK-FOR-STORM-DRAIN-DB2</font></b></td></tr><tr><td align="center" cellpadding="1"><font color="#64748B" point-size="8">L2101-2130 | 7 stmts | CC:3</font></td></tr><tr><td align="center" cellpadding="1"><font color="#5C2D91" point-size="8"><b>[+1 exit]</b></font></td></tr></table>>, fillcolor="#FFFFFF", color="#008272", penwidth=1.5, tooltip="CHECK-FOR-STORM-DRAIN-DB2 (Lines 2101-2130)"];
        p_POPULATE_TIME_DATE [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="2"><tr><td align="center" cellpadding="2"><b><font point-size="11">POPULATE-TIME-DATE</font></b></td></tr><tr><td align="center" cellpadding="1"><font color="#64748B" point-size="8">L2273-2288 | 3 stmts | CC:1</font></td></tr><tr><td align="center" cellpadding="1"><font color="#5C2D91" point-size="8"><b>[SQL:2 | +1 exit]</b></font></td></tr></table>>, fillcolor="#FFFFFF", color="#008272", penwidth=1.5, tooltip="POPULATE-TIME-DATE (Lines 2273-2288)"];
    }

    subgraph "cluster_3_cluster_error" {
