        fontsize=11;
        penwidth=1.5;

        p_GET_ME_OUT_OF_HERE [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="2"><tr><td align="center" cellpadding="2"><b><font point-size="11">GET-ME-OUT-OF-HERE</font></b></td></tr><tr><td align="center" cellpadding="1"><font color="#64748B" point-size="8">L2090-2098 | 3 stmts | CC:1</font></td></tr><tr><td align="center" cellpadding="1"><font color="#DC2626" point-size="8"><b>[SQL:1 | TERMINAL | +1 exit]</b></font></td></tr></table>>, fillcolor="#FFFFFF", color="#475569", penwidth=1.5, tooltip="GET-ME-OUT-OF-HERE (Lines 2090-2098)"];
    }

    // Procedure Control Flow Edges
    p_PREMIERE -> p_GET_ME_OUT_OF_HERE [color="#0078D4", penwidth=1.5, tooltip="PERFORM"];
    p_PREMIERE -> p_UPDATE_ACCOUNT_DB2 [color="#0078D4", penwidth=1.5, tooltip="PERFORM"];
    p_UPDATE_ACCOUNT_DB2 -> p_POPULATE_TIME_DATE [color="#0078D4", penwidth=1.5, tooltip="PERFORM"];
    p_UPDATE_ACCOUNT_DB2 -> p_UPDATE_ACCOUNT_DB2_FROM [color="#0078D4", penwidth=1.5, tooltip="PERFORM"];
    p_UPDATE_ACCOUNT_DB2 -> p_UPDATE_ACCOUNT_DB2_TO [color="#0078D4", penwidth=1.5, tooltip="PERFORM"];
    p_UPDATE_ACCOUNT_DB2 -> p_WRITE_TO_PROCTRAN [color="#0078D4", penwidth=1.5, tooltip="PERFORM"];
    p_UPDATE_ACCOUNT_DB2_FROM -> p_CHECK_FOR_STORM_DRAIN_DB2 [color="#0078D4", penwidth=1.5, tooltip="PERFORM"];
    p_UPDATE_ACCOUNT_DB2_TO -> p_CHECK_FOR_STORM_DRAIN_DB2 [color="#0078D4", penwidth=1.5, tooltip="PERFORM"];
    p_UPDATE_ACCOUNT_DB2_TO -> p_POPULATE_TIME_DATE [color="#0078D4", penwidth=1.5, tooltip="PERFORM"];
    p_UPDATE_ACCOUNT_DB2_TO -> p_UPDATE_ACCOUNT_DB2 [style="dashed", color="#5C2D91", penwidth=1.2, label="GO TO", fontcolor="#5C2D91"];
    p_WRITE_TO_PROCTRAN -> p_WRITE_TO_PROCTRAN_DB2 [color="#0078D4", penwidth=1.5, tooltip="PERFORM"];
    p_WRITE_TO_PROCTRAN_DB2 -> p_POPULATE_TIME_DATE [color="#0078D4", penwidth=1.5, tooltip="PERFORM"];
    p_WRITE_TO_PROCTRAN_DB2 -> p_CHECK_FOR_STORM_DRAIN_DB2 [color="#0078D4", penwidth=1.5, tooltip="PERFORM"];
    p_ABEND_HANDLING -> p_POPULATE_TIME_DATE [color="#0078D4", penwidth=1.5, tooltip="PERFORM"];
