digraph "XFRFUN_CallGraph" {
    // Global Graph Attributes
    rankdir=TB;
    compound=true;
    splines=spline;
    nodesep=0.45;
    ranksep=0.75;
    ratio=auto;
    bgcolor="#FFFFFF";
    fontname="Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, Helvetica, Arial, sans-serif";
    fontsize=12;
    node [fontname="Segoe UI, Helvetica, Arial, sans-serif", fontsize=10, shape=box, style="filled,rounded", penwidth=1.5, margin="0.15,0.08"];
    edge [fontname="Segoe UI, Helvetica, Arial, sans-serif", fontsize=8, arrowsize=0.75];

    subgraph "cluster_0_cluster_main_driver" {
        label="Main Control &amp; Driver";
        style="filled,rounded";
        color="#1A365D";
        fillcolor="#EBF4FF";
        fontcolor="#1A365D";
        fontsize=11;
        penwidth=1.5;

        p_A010 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="2"><tr><td align="center" bgcolor="#0078D4" cellpadding="3"><font color="#FFFFFF" point-size="9"><b>&#9654; START / ENTRY POINT</b></font></td></tr><tr><td align="center" cellpadding="2"><b><font point-size="11">PREMIERE</font></b></td></tr><tr><td align="center" cellpadding="0"><font color="#475569" point-size="9">&#167; A010</font></td></tr><tr><td align="center" cellpadding="1"><font color="#64748B" point-size="8">L489-521 | 13 stmts | CC:2</font></td></tr><tr><td align="center" cellpadding="1"><font color="#5C2D91" point-size="8"><b>[SQL:1]</b></font></td></tr></table>>, fillcolor="#FFFFFF", color="#0078D4", penwidth=2.5, tooltip="[START] PREMIERE : A010 (Lines 489-521)"];
    }

    subgraph "cluster_1_cluster_file_io" {
        label="File I/O Operations";
        style="filled,rounded";
        color="#107C41";
        fillcolor="#F2F9F4";
        fontcolor="#0B5A2F";
        fontsize=11;
        penwidth=1.5;

        p_WTP010 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="2"><tr><td align="center" cellpadding="2"><b><font point-size="11">WRITE-TO-PROCTRAN</font></b></td></tr><tr><td align="center" cellpadding="0"><font color="#475569" point-size="9">&#167; WTP010</font></td></tr><tr><td align="center" cellpadding="1"><font color="#64748B" point-size="8">L1783-1785 | 1 stmts | CC:1</font></td></tr></table>>, fillcolor="#FFFFFF", color="#107C41", penwidth=1.5, tooltip="WRITE-TO-PROCTRAN : WTP010 (Lines 1783-1785)"];
    }

