<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CobolScope Documentation Portal - {{ title | default('Batch Overview') }}</title>
  <style>
    {% include "portal/styles.css.j2" %}
    {% include "portal/splitters.css.j2" %}
    {% include "portal/code_viewer.css.j2" %}
  </style>
</head>
<body>

  <main class="portal-main">
    <div id="viewer-container" style="display:flex; width:100%; height:100%;">
      {% include "portal/sidebar.html.j2" %}
      {% include "portal/viewer.html.j2" %}
    </div>
  </main>

  <!-- Embedded Manifest Data for Synchronous Zero-CORS Loading -->
  <script id="cobolscope-manifest" type="application/json">
    {{ manifest | tojson }}
  </script>

  <!-- Zero-Dependency Portal Controller Logic -->
  <script>
    {% include "portal/js/state.js.j2" %}
    {% include "portal/js/sidebar.js.j2" %}
    {% include "portal/js/viewer.js.j2" %}
    {% include "portal/js/splitters.js.j2" %}
  </script>
</body>
</html>
