{% extends "base.html.j2" %}
{% import "macros.j2" as macros %}

{% block title %}Procedure Call Graph - {{ program_id }}{% endblock %}

{% block vendor_scripts %}
  <!-- Cytoscape.js & Layout Extensions -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/cytoscape/3.28.1/cytoscape.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/dagre@0.8.5/dist/dagre.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/cytoscape-dagre@2.5.0/cytoscape-dagre.min.js"></script>
{% endblock %}

{% block styles %}
  {% include "call_graph/styles.css.j2" %}
{% endblock %}

{% block content %}
  {% include "call_graph/header.html.j2" %}
  <div class="workspace">
    {% include "call_graph/canvas.html.j2" %}
    {% include "call_graph/inspector.html.j2" %}
  </div>
  {% include "call_graph/level3_modal.html.j2" %}
  {% include "call_graph/linear_modal.html.j2" %}
  <textarea id="dotSource" style="display:none;">{{ dot_content }}</textarea>
{% endblock %}

{% block scripts %}
  <script>
    {% include "call_graph/js/diagnostics.js.j2" %}

    const graphData = {{ graph.model_dump_json() | safe }};
    const cytoElements = {{ cyto_json | safe }};
    const initialEnginePreference = "{{ initial_engine }}";

    CobolScopeLog.info(`Loaded graphData for ${graphData.program_id}: ${graphData.total_paragraphs} paragraphs, ${cytoElements.length} Cytoscape elements.`);

    let currentEngine = initialEnginePreference || "cytoscape";
    let cy = null;
    let cyLevel3 = null;
    let selectedRoutineNode = null;

    // SVG Viewport Pan / Zoom State
    let scale = 1.0;
    let panX = 0;
    let panY = 0;
    let isDragging = false;
    let startX = 0;
    let startY = 0;

    const svgContainer = document.getElementById("svg-container");
    const svgWrapper = document.getElementById("svg-wrapper");
    const svg = svgWrapper ? svgWrapper.querySelector("svg") : null;
    const cyContainer = document.getElementById("cy-container");
    const layoutSelect = document.getElementById("layoutSelect");
    const cytoLayoutGroup = document.getElementById("cytoLayoutGroup");

    {% include "call_graph/js/cyto_call_graph.js.j2" %}
    {% include "call_graph/js/svg_viewer.js.j2" %}
    {% include "call_graph/js/inspector.js.j2" %}
    {% include "call_graph/js/linear_modal.js.j2" %}
    {% include "call_graph/js/level3_cfg.js.j2" %}
    {% include "call_graph/js/toolbar.js.j2" %}
  </script>
{% endblock %}
