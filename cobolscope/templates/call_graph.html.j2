{% extends "base.html.j2" %}
{% import "macros.j2" as macros %}

{% block title %}Procedure Call Graph - {{ program_id }}{% endblock %}

{% block head_styles %}
  {% if asset_mode == "external" %}
    <!-- CobolScope Static Pre-Bundled Assets (Relative) -->
    <link rel="stylesheet" href="{{ assets_rel_path }}/cobolscope-viewer.css">
  {% endif %}
{% endblock %}

{% block styles %}
  {% if asset_mode == "inline" and bundled_css %}
    <!-- Inlined CobolScope CSS (Air-Gapped & Offline Ready) -->
    {{ bundled_css | safe }}
  {% elif asset_mode != "external" %}
    {% include "call_graph/styles.css.j2" %}
  {% endif %}
{% endblock %}

{% block content %}
  {% include "call_graph/header.html.j2" %}
  <div class="workspace">
    <div class="workspace-main" id="workspaceMain">
      {% include "call_graph/canvas.html.j2" %}
      <div class="workspace-splitter" id="splitterCanvasCode" style="display:none;" title="Drag to resize Graph and Code panes">
        <div class="splitter-handle"></div>
      </div>
      {% include "call_graph/code_viewer.html.j2" %}
    </div>
    <div class="workspace-splitter" id="splitterInspector" title="Drag to resize Inspector Sidebar">
      <div class="splitter-handle"></div>
    </div>
    {% include "call_graph/inspector.html.j2" %}
  </div>
  {% include "call_graph/level3_modal.html.j2" %}
  {% include "call_graph/linear_modal.html.j2" %}
{% endblock %}

{% block scripts %}
  <!-- Embedded Zero-CORS JSON Data Island -->
  <script id="cobolscope-data" type="application/json">
    {{ graph_payload_json | safe }}
  </script>

  {% if asset_mode == "external" %}
    <!-- CobolScope Static Pre-Bundled Assets (Relative) -->
    <script src="{{ assets_rel_path }}/cobolscope-viewer.bundle.js"></script>
  {% elif asset_mode == "inline" and bundled_js %}
    <!-- Inlined Monolithic Runtime Bundle (Air-Gapped & Offline Ready) -->
    <script>
      {{ bundled_js | safe }}
    </script>
  {% else %}
    <!-- Fallback Development Runtime -->
    <script src="{{ assets_rel_path }}/vendor.bundle.js"></script>
    <script src="{{ assets_rel_path }}/cobolscope-viewer.js"></script>
  {% endif %}
{% endblock %}
