  <!-- Unified Enterprise Navbar (48px) -->
  <header class="navbar">
    <div class="navbar-left">
      <div class="brand">
        <span class="brand-title">COBOLSCOPE</span>
        <span class="brand-divider">/</span>
        <div class="program-info-wrapper">
          <button class="program-title-btn" id="btnProgramInfo" title="Click for program details and metrics">
            <code class="program-title">{{ program_id }}</code>
            <svg class="info-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="16" x2="12" y2="12"></line>
              <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
          </button>

          <!-- Popover showing program metrics/details on click -->
          <div class="program-info-popover" id="programInfoPopover" style="display:none;">
            <div class="popover-header">
              <span class="popover-title">Program Details</span>
              <button class="popover-close-btn" id="btnCloseProgramInfo" title="Close">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              </button>
            </div>
            <div class="popover-body">
              <div class="popover-row">
                <span class="popover-label">Program:</span>
                <code class="popover-val font-mono">{{ program_id }}</code>
              </div>
              {% if graph.entry_point %}
              <div class="popover-row">
                <span class="popover-label">Entry Routine:</span>
                <span class="popover-val entry-link" id="hdrEntryPoint" title="Click to jump to entry routine">{{ graph.entry_point }}</span>
              </div>
              {% endif %}
              <div class="popover-row">
                <span class="popover-label">Routines:</span>
                <span class="popover-val font-mono">{{ graph.total_paragraphs }}</span>
              </div>
              <div class="popover-row">
                <span class="popover-label">Routine Calls:</span>
                <span class="popover-val font-mono">{{ graph.total_calls }}</span>
              </div>
              <div class="popover-row">
                <span class="popover-label">Call Depth:</span>
                <span class="popover-val font-mono">{{ graph.max_depth }}</span>
              </div>
              <div class="popover-row">
                <span class="popover-label">Recursion / Cycles:</span>
                <span class="popover-val {% if graph.has_cycles %}text-warning{% endif %}">
                  {{ "Detected" if graph.has_cycles else "None" }}
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="navbar-center">
      <div class="search-box">
        <svg class="search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <input type="text" id="nodeSearch" placeholder="Search routines...">
        <kbd class="search-kbd" id="searchKbdShortcut" title="Press / to focus">/</kbd>
      </div>
    </div>

    <div class="navbar-right">
      <!-- Toggle Split Code View (65% Graph / 35% Code) -->
      <button class="btn btn-code-toggle" id="btnToggleCodeSplit" title="Toggle Code Split View (65% Graph / 35% Code) [Alt+C]">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="14" y1="3" x2="14" y2="21"/></svg>
        <span>Split Code</span>
      </button>

      <!-- Toggle Inspector Sidebar -->
      <button class="btn btn-inspector-toggle active" id="btnToggleInspector" title="Toggle Inspector Sidebar">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="16" y1="3" x2="16" y2="21"/></svg>
        <span>Inspector</span>
      </button>

      <!-- Layout Dropdown (Cytoscape) & Disentangle Toggle -->
      <div id="cytoLayoutGroup" style="display:flex; align-items:center; gap:8px;">
        <select class="layout-select" id="layoutSelect" title="Graph Layout Engine">
          <option value="dagre" selected>Dagre (Hierarchy)</option>
          <option value="elk-layered">ELK (Layered)</option>
          <option value="breadthfirst">Breadthfirst (Layers)</option>
        </select>
        {% if clone_count and clone_count > 0 %}
        <label class="toggle-clone-label" id="lblCloneUtilities" title="Disentangle high in-degree utility routines by replicating them locally per caller/section" style="display:inline-flex; align-items:center; font-size:12px; gap:4px; cursor:pointer; color:var(--text-secondary); user-select:none; margin-left:4px;">
          <input type="checkbox" id="toggleCloneUtilities"{% if enable_cloning %} checked{% endif %}>
          <span>Disentangle ({{ clone_count }} clones)</span>
        </label>
        {% endif %}
      </div>

    </div>
  </header>
