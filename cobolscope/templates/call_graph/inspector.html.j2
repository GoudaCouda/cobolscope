<!-- Node Inspector Sidebar -->
    <div class="inspector" id="inspector">
      <div class="inspector-header">
        <div class="inspector-title-row">
          <div class="inspector-title-wrap">
            <h2 id="inspTitle" class="inspector-routine-name">Paragraph Inspector</h2>
            <button class="program-title-btn" id="btnRoutineInfo" title="Click for procedure details">
              <svg class="info-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="16" x2="12" y2="12"></line>
                <line x1="12" y1="8" x2="12.01" y2="8"></line>
              </svg>
            </button>
          </div>
          <button class="inspector-close-btn" id="btnCloseInspector" title="Close Inspector Sidebar">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          </button>
        </div>

        <!-- Routine Details Popover -->
        <div class="routine-info-popover" id="routineInfoPopover" style="display:none;">
          <div class="popover-header">
            <span class="popover-title">Procedure Details</span>
            <button class="popover-close-btn" id="btnCloseRoutineInfo" title="Close">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
          </div>
          <div class="popover-body">
            <div class="popover-row">
              <span class="popover-label">Paragraph:</span>
              <code class="popover-val font-mono" id="inspPara">-</code>
            </div>
            <div class="popover-row">
              <span class="popover-label">Section:</span>
              <span class="popover-val font-mono" id="inspSection">-</span>
            </div>
            <div class="popover-row">
              <span class="popover-label">Line Span:</span>
              <span class="popover-val font-mono" id="inspLines">-</span>
            </div>
            <div class="popover-row">
              <span class="popover-label">Complexity (CC):</span>
              <span class="popover-val font-mono" id="inspCC">-</span>
            </div>
            <div class="popover-row">
              <span class="popover-label">Statements:</span>
              <span class="popover-val font-mono" id="inspStmts">-</span>
            </div>
            <div class="popover-row">
              <span class="popover-label">Cluster:</span>
              <span class="popover-val font-mono" id="inspCluster">-</span>
            </div>
          </div>
        </div>

        <!-- Metadata row directly below node name (no container box) -->
        <div class="inspector-meta-row">
          <span class="badge badge-entry-point" id="inspEntryBadge" style="display:none;">Program Entry</span>
          <span class="badge badge-routine-type" id="inspTypeBadge">Procedure</span>
          <span id="inspSubtitle" class="inspector-subtitle"></span>
        </div>
      </div>
      <div class="inspector-body">
        <div class="inspector-actions-bar">
          <button class="routine-action-btn btn-view-routine-code" id="btnViewRoutineCode" title="View procedure source lines in split code viewer" disabled>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
            <span id="btnViewRoutineCodeText">Source Code</span>
          </button>
          <button class="routine-action-btn btn-view-flowchart" id="btnOpenFlowchart" title="View procedure logic flowchart" disabled>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="8" height="8" x="3" y="3" rx="2"/><path d="M7 11v4a2 2 0 0 0 2 2h4"/><rect width="8" height="8" x="13" y="13" rx="2"/></svg>
            <span id="btnOpenFlowchartText">Logic Flowchart</span>
          </button>
        </div>
        <!-- Linear Statement Section Area (if routine is linear) -->
        <div id="inspCfgSection"></div>

        <div class="inspector-section">
          <div class="section-title">Invoked By (Callers)</div>
          <div class="tag-list" id="inspCallers">
            <span style="font-size:0.8rem; color:var(--text-muted);">None</span>
          </div>
        </div>

        <div class="inspector-section">
          <div class="section-title">Calls (Successors)</div>
          <div class="tag-list" id="inspSuccessors">
            <span style="font-size:0.8rem; color:var(--text-muted);">None</span>
          </div>
        </div>

        <div class="inspector-section">
          <div class="section-title">Variables Read (Source DFG)</div>
          <div class="tag-list" id="inspReadFields">
            <span style="font-size:0.8rem; color:var(--text-muted);">No variable reads</span>
          </div>
        </div>

        <div class="inspector-section">
          <div class="section-title">Variables Modified (Target DFG)</div>
          <div class="tag-list" id="inspWriteFields">
            <span style="font-size:0.8rem; color:var(--text-muted);">No variable writes</span>
          </div>
        </div>
      </div>
    </div>
