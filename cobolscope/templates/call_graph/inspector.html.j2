<!-- Node Inspector Sidebar -->
    <div class="inspector" id="inspector">
      <div class="inspector-header">
        <div style="flex:1; min-width:0; position:relative;">
          <div style="display:flex; align-items:center; gap:6px;">
            <h2 id="inspTitle">Paragraph Inspector</h2>
            <button class="program-title-btn" id="btnRoutineInfo" title="Click for procedure details">
              <svg class="info-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="16" x2="12" y2="12"></line>
                <line x1="12" y1="8" x2="12.01" y2="8"></line>
              </svg>
            </button>
          </div>
          <div id="inspSubtitle" style="font-size:0.8rem; color:var(--text-secondary); margin-top:2px;"></div>

          <!-- Routine Details Popover -->
          <div class="routine-info-popover" id="routineInfoPopover" style="display:none;">
            <div class="popover-header">
              <span class="popover-title">Procedure Details</span>
              <button class="popover-close-btn" id="btnCloseRoutineInfo" title="Close">✕</button>
            </div>
            <div class="popover-body">
              <div class="popover-row">
                <span class="popover-label">Paragraph:</span>
                <code class="popover-val font-mono" id="inspPara">-</code>
              </div>
              <div class="popover-row">
                <span class="popover-label">Section:</span>
                <span class="popover-val font-mono" id="inspSection">-</span>
              </div>
              <div class="popover-row">
                <span class="popover-label">Line Span:</span>
                <span class="popover-val font-mono" id="inspLines">-</span>
              </div>
              <div class="popover-row">
                <span class="popover-label">Complexity (CC):</span>
                <span class="popover-val font-mono" id="inspCC">-</span>
              </div>
              <div class="popover-row">
                <span class="popover-label">Statements:</span>
                <span class="popover-val font-mono" id="inspStmts">-</span>
              </div>
              <div class="popover-row">
                <span class="popover-label">Cluster:</span>
                <span class="popover-val font-mono" id="inspCluster">-</span>
              </div>
            </div>
          </div>
        </div>
        <div style="display:flex; align-items:center; gap:8px;">
          <span class="badge" id="inspTypeBadge">GENERIC</span>
          <button class="inspector-close-btn" id="btnCloseInspector" title="Close Inspector Sidebar">✕</button>
        </div>
      </div>
      <div class="inspector-body">
        <div class="inspector-section">
          <div>
            <button class="btn btn-view-routine-code" id="btnViewRoutineCode" title="View procedure source lines in split code viewer">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
              <span>View Routine Code</span>
            </button>
          </div>
          <!-- Level 3 CFG Action / Linear Summary Card Area -->
          <div id="inspCfgSection" style="margin-top:10px;"></div>
        </div>

        <div class="inspector-section">
          <div class="section-title">Invoked By (Callers)</div>
          <div class="tag-list" id="inspCallers">
            <span style="font-size:0.8rem; color:var(--text-muted);">None</span>
          </div>
        </div>

        <div class="inspector-section">
          <div class="section-title">Calls (Successors)</div>
          <div class="tag-list" id="inspSuccessors">
            <span style="font-size:0.8rem; color:var(--text-muted);">None</span>
          </div>
        </div>

        <div class="inspector-section">
          <div class="section-title">Variables Read (Source DFG)</div>
          <div class="tag-list" id="inspReadFields">
            <span style="font-size:0.8rem; color:var(--text-muted);">No variable reads</span>
          </div>
        </div>

        <div class="inspector-section">
          <div class="section-title">Variables Modified (Target DFG)</div>
          <div class="tag-list" id="inspWriteFields">
            <span style="font-size:0.8rem; color:var(--text-muted);">No variable writes</span>
          </div>
        </div>
      </div>
    </div>
