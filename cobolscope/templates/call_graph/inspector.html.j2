<!-- Node Inspector Sidebar -->
    <div class="inspector" id="inspector">
      <div class="inspector-header">
        <div>
          <h2 id="inspTitle">Paragraph Inspector</h2>
          <div id="inspSubtitle" style="font-size:0.8rem; color:var(--text-secondary); margin-top:2px;"></div>
        </div>
        <span class="badge" id="inspTypeBadge">GENERIC</span>
      </div>
      <div class="inspector-body">
        <div class="inspector-section">
          <div class="section-title">Execution Context</div>
          <div class="meta-grid">
            <div class="meta-card">
              <div class="meta-label">Section</div>
              <div class="meta-val" id="inspSection" style="word-break:break-word; font-size:0.8rem;">-</div>
            </div>
            <div class="meta-card">
              <div class="meta-label">Paragraph</div>
              <div class="meta-val" id="inspPara" style="font-size:0.8rem;">-</div>
            </div>
            <div class="meta-card">
              <div class="meta-label">Line Span</div>
              <div class="meta-val" id="inspLines">-</div>
            </div>
            <div class="meta-card">
              <div class="meta-label">Complexity (CC)</div>
              <div class="meta-val" id="inspCC">-</div>
            </div>
            <div class="meta-card">
              <div class="meta-label">Statements</div>
              <div class="meta-val" id="inspStmts">-</div>
            </div>
            <div class="meta-card">
              <div class="meta-label">Cluster</div>
              <div class="meta-val" id="inspCluster">-</div>
            </div>
          </div>
          <div style="margin-top:10px;">
            <button class="btn btn-sm" id="btnViewRoutineCode" style="width:100%; display:flex; align-items:center; justify-content:center; gap:6px; font-size:0.75rem; padding:6px 8px; border:1px solid #C7E0F4; background:#EFF6FC; color:#0078D4; font-weight:600; cursor:pointer;" title="View procedure source lines in code split pane">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
              <span>View Routine Code</span>
            </button>
          </div>
          <!-- Level 3 CFG Action / Linear Summary Card Area -->
          <div id="inspCfgSection" style="margin-top:14px;"></div>
        </div>

        <div class="inspector-section">
          <div class="section-title">Invoked By (Callers)</div>
          <div class="tag-list" id="inspCallers">
            <span style="font-size:0.8rem; color:var(--text-muted);">None</span>
          </div>
        </div>

        <div class="inspector-section">
          <div class="section-title">Calls (Successors)</div>
          <div class="tag-list" id="inspSuccessors">
            <span style="font-size:0.8rem; color:var(--text-muted);">None</span>
          </div>
        </div>

        <div class="inspector-section">
          <div class="section-title">Variables Read (Source DFG)</div>
          <div class="tag-list" id="inspReadFields">
            <span style="font-size:0.8rem; color:var(--text-muted);">No variable reads</span>
          </div>
        </div>

        <div class="inspector-section">
          <div class="section-title">Variables Modified (Target DFG)</div>
          <div class="tag-list" id="inspWriteFields">
            <span style="font-size:0.8rem; color:var(--text-muted);">No variable writes</span>
          </div>
        </div>
      </div>
    </div>
