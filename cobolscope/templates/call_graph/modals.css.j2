    /* Level 3 Intra-Procedure CFG Modal */
    .cfg-modal-backdrop {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: rgba(17, 24, 39, 0.65);
      backdrop-filter: blur(4px);
      z-index: 99999;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      overflow-y: auto;
    }

    .cfg-modal {
      width: 92vw;
      height: 88vh;
      max-width: 1440px;
      max-height: calc(100vh - 48px);
      background: var(--bg-surface);
      border-radius: 8px;
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.16), 0 2px 6px rgba(0, 0, 0, 0.08);
      display: flex;
      flex-direction: column;
      overflow: hidden;
      border: 1px solid var(--border-color);
    }

    .cfg-modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 14px 20px;
      background: var(--bg-primary);
      border-bottom: 1px solid var(--border-color);
      flex-shrink: 0;
    }

    .cfg-modal-canvas {
      flex: 1;
      width: 100%;
      height: 100%;
      background: var(--bg-surface);
      position: relative;
    }
