    /* Inspector Sidebar */
.inspector {
      width: var(--sidebar-width);
      background: var(--bg-surface);
      border-left: 1px solid var(--border-color);
      display: flex;
      flex-direction: column;
      overflow: hidden;
      z-index: 10;
      box-shadow: -2px 0 6px rgba(0, 0, 0, 0.03);
    }

    .inspector-header {
      padding: 16px 20px;
      border-bottom: 1px solid var(--border-color);
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 12px;
    }

    .inspector-close-btn {
      width: 26px;
      height: 26px;
      border-radius: 4px;
      border: 1px solid var(--border-color);
      background: transparent;
      color: var(--text-muted);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      line-height: 1;
      transition: all 0.15s ease;
      flex-shrink: 0;
    }

    .inspector-close-btn:hover {
      background: #F1F5F9;
      color: var(--text-primary);
      border-color: #CBD5E1;
    }

    .btn-view-routine-code {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      font-size: 0.85rem;
      font-weight: 700;
      padding: 9px 12px;
      border-radius: 6px;
      border: 1px solid #0078D4;
      background: #EFF6FC;
      color: #0078D4;
      cursor: pointer;
      transition: all 0.15s ease;
      box-shadow: 0 1px 2px rgba(0, 120, 212, 0.08);
    }

    .btn-view-routine-code:hover:not(:disabled) {
      background: #0078D4;
      color: #FFFFFF;
      border-color: #0078D4;
      box-shadow: 0 2px 4px rgba(0, 120, 212, 0.2);
    }

    .btn-view-routine-code:disabled {
      opacity: 0.5;
      cursor: not-allowed;
      border-color: #CBD5E1;
      background: #F1F5F9;
      color: #94A3B8;
      box-shadow: none;
    }

    .inspector-header h2 {
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--text-primary);
      word-break: break-word;
    }

    .inspector-body {
      flex: 1;
      overflow-y: auto;
      padding: 16px 20px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .inspector-section {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .section-title {
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-muted);
    }

    .meta-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
    }

    .meta-card {
      background: #F8FAFC;
      border: 1px solid var(--border-color);
      padding: 8px 10px;
      border-radius: 6px;
    }

    .meta-label {
      font-size: 0.7rem;
      color: var(--text-muted);
      font-weight: 500;
      margin-bottom: 2px;
    }

    .meta-val {
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--text-primary);
    }

    .tag-list {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }

    .tag {
      display: inline-flex;
      align-items: center;
      padding: 3px 8px;
      border-radius: 4px;
      font-size: 0.75rem;
      font-weight: 500;
      background: #F1F5F9;
      color: var(--text-secondary);
      border: 1px solid var(--border-color);
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .tag:hover {
      background: var(--primary-light);
      color: var(--primary);
      border-color: #C7E0F4;
    }

    .field-tag-read {
      background: #F0FDF4;
      color: #166534;
      border-color: #DCFCE7;
    }

    .field-tag-write {
      background: #FEF2F2;
      color: #991B1B;
      border-color: #FEE2E2;
    }

    .routine-info-popover {
      position: absolute;
      top: calc(100% + 6px);
      left: 0;
      width: 260px;
      background: #FFFFFF;
      border: 1px solid var(--border-color);
      border-radius: 8px;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
      z-index: 1000;
      padding: 12px 14px;
      font-size: 12px;
      color: var(--text-primary);
    }
