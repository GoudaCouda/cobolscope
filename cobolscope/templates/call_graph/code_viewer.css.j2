    /* Code Split View Toggle Buttons */
    .btn-code-toggle {
      height: 28px;
      padding: 2px 10px;
      font-size: 0.75rem;
      font-weight: 600;
      background: #FFFFFF;
      border: 1px solid var(--border-color);
      border-radius: 6px;
      cursor: pointer;
      color: var(--text-primary);
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.15s ease;
    }

    .btn-code-toggle:hover {
      background: #F1F5F9;
      border-color: #CBD5E1;
    }

    .btn-code-toggle.active {
      background: var(--primary-light);
      border-color: rgba(0, 120, 212, 0.4);
      color: var(--primary);
    }

    .btn-inspector-toggle {
      height: 28px;
      padding: 2px 10px;
      font-size: 0.75rem;
      font-weight: 600;
      background: #FFFFFF;
      border: 1px solid var(--border-color);
      border-radius: 6px;
      cursor: pointer;
      color: var(--text-primary);
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.15s ease;
    }

    .btn-inspector-toggle:hover {
      background: #F1F5F9;
      border-color: #CBD5E1;
    }

    .btn-inspector-toggle.active {
      background: var(--primary-light);
      border-color: rgba(0, 120, 212, 0.4);
      color: var(--primary);
    }

    /* Split-Screen Code Pane */
    .code-split-pane {
      display: flex;
      flex-direction: column;
      background: #FFFFFF;
      min-width: 260px;
      overflow: hidden;
      position: relative;
      z-index: 5;
    }

    .code-pane-header {
      height: 38px;
      min-height: 38px;
      background: #F8FAFC;
      border-bottom: 1px solid var(--border-color);
      padding: 0 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }

    .code-pane-title-area {
      display: flex;
      align-items: center;
      gap: 8px;
      overflow: hidden;
      min-width: 0;
    }

    .code-pane-label {
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.06em;
      color: var(--text-secondary);
      flex-shrink: 0;
    }

    .code-routine-badge {
      font-size: 0.72rem;
      font-weight: 600;
      color: var(--primary);
      background: var(--primary-light);
      border: 1px solid rgba(0, 120, 212, 0.25);
      padding: 1px 6px;
      border-radius: 4px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 240px;
    }

    .code-pane-actions {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-shrink: 0;
    }

    .code-search-box input {
      height: 24px;
      width: 140px;
      font-size: 0.72rem;
      padding: 2px 6px;
      border: 1px solid var(--border-color);
      border-radius: 4px;
      outline: none;
      background: #FFFFFF;
      transition: width 0.15s ease, border-color 0.15s ease;
    }

    .code-search-box input:focus {
      width: 180px;
      border-color: var(--primary);
    }

    .code-btn-action {
      height: 24px;
      padding: 0 8px;
      font-size: 0.7rem;
      font-weight: 600;
      background: #FFFFFF;
      border: 1px solid var(--border-color);
      border-radius: 4px;
      cursor: pointer;
      color: var(--text-secondary);
    }

    .code-btn-action:hover {
      background: #F1F5F9;
      color: var(--text-primary);
    }

    .code-btn-close {
      height: 24px;
      width: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.85rem;
      background: transparent;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      color: var(--text-muted);
    }

    .code-btn-close:hover {
      background: #F1F5F9;
      color: var(--text-primary);
    }

    .code-pane-subbar {
      height: 24px;
      background: #F1F5F9;
      border-bottom: 1px solid var(--border-color);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 12px;
      font-size: 0.68rem;
      color: var(--text-muted);
    }

    .cobol-columns-indicator {
      display: flex;
      gap: 8px;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 0.65rem;
    }

    .col-guide {
      color: #94A3B8;
    }

    .col-guide:hover {
      color: var(--text-secondary);
    }

    .code-line-info {
      font-size: 0.68rem;
      font-weight: 500;
      color: var(--text-secondary);
    }

    .code-pane-content {
      flex: 1;
      overflow: auto;
      background: #FFFFFF;
      position: relative;
    }

    .code-empty-state {
      padding: 40px 20px;
      text-align: center;
      color: var(--text-muted);
      font-size: 0.8rem;
    }

    table.cobol-code-table {
      width: 100%;
      border-collapse: collapse;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 0.78rem;
      line-height: 1.5;
    }

    table.cobol-code-table tr {
      transition: background-color 0.1s ease;
    }

    table.cobol-code-table tr:hover td {
      background-color: #F8FAFC;
    }

    td.code-line-num {
      width: 50px;
      min-width: 50px;
      text-align: right;
      padding: 0 8px;
      color: #94A3B8;
      background: #F8FAFC;
      border-right: 1px solid var(--border-color);
      user-select: none;
      cursor: pointer;
      font-size: 0.72rem;
    }

    td.code-line-num:hover {
      color: var(--primary);
    }

    td.code-line-text {
      padding: 0 10px;
      white-space: pre;
      color: #1E293B;
    }

    tr.line-highlighted td.code-line-text {
      background: #EFF6FC !important;
      color: #0F172A;
    }

    tr.line-highlighted td.code-line-num {
      background: #E0F2FE !important;
      color: var(--primary);
      font-weight: 700;
    }

    tr.line-highlight-start td.code-line-text {
      border-left: 3px solid var(--primary);
      font-weight: 600;
    }
