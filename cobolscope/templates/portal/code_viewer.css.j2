    /* Portal Source Code Viewer Container */
    .source-container {
      display: flex;
      flex-direction: column;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: #FFFFFF;
    }

    .source-toolbar {
      height: 30px;
      background: var(--bg-primary);
      border-bottom: 1px solid var(--border-color);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 12px;
      font-size: 11px;
      color: var(--text-muted);
    }

    .source-title-area {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .source-prog-title {
      font-size: 11px;
      font-weight: 700;
      color: var(--text-primary);
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    }

    .cobol-columns-indicator {
      display: flex;
      gap: 8px;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 11px;
    }

    .col-guide {
      color: var(--text-muted);
    }

    .source-search-box input {
      height: 22px;
      width: 160px;
      font-size: 11px;
      padding: 2px 6px;
      border: 1px solid var(--border-color);
      border-radius: 4px;
      outline: none;
      background: #FFFFFF;
    }

    .source-table-wrap {
      flex: 1;
      overflow: auto;
      background: #FFFFFF;
    }

    table.cobol-code-table {
      width: 100%;
      border-collapse: collapse;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 12px;
      line-height: 1.5;
    }

    table.cobol-code-table tr td {
      border-bottom: none !important;
    }

    table.cobol-code-table tr:hover td {
      background-color: var(--surface-hover);
    }

    td.code-line-num {
      width: 55px;
      min-width: 55px;
      text-align: right;
      padding: 0 8px;
      color: var(--text-muted);
      background: var(--bg-primary);
      border-right: 1px solid var(--border-color);
      border-bottom: none !important;
      user-select: none;
      font-size: 11px;
    }

    td.code-line-text {
      padding: 0 10px;
      white-space: pre;
      color: var(--text-primary);
      border-bottom: none !important;
    }

    tr.line-highlighted td.code-line-text {
      background: var(--primary-light) !important;
    }

    tr.line-highlighted td.code-line-num {
      background: var(--primary-border) !important;
      color: var(--primary);
      font-weight: 700;
    }

    .code-word {
      cursor: pointer;
      border-radius: 2px;
      transition: background-color 0.12s ease, box-shadow 0.12s ease;
    }

    .code-word:hover {
      background-color: var(--primary-light);
    }

    .code-word.var-highlight {
      background-color: #FEF08A !important;
      color: #854D0E !important;
      font-weight: 700;
      border-radius: 3px;
      box-shadow: 0 0 0 1.5px #FDE047;
    }

    .code-comment {
      color: #64748B;
      font-style: italic;
    }
