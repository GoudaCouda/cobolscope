    /* Resizable Sidebar & Splitter Styles */
    .portal-splitter {
      width: 6px;
      background: var(--border-color);
      cursor: col-resize;
      user-select: none;
      touch-action: none;
      position: relative;
      z-index: 20;
      transition: background 0.15s;
      flex-shrink: 0;
    }

    .portal-splitter:hover,
    .portal-splitter.active {
      background: var(--primary);
    }

    body.is-resizing {
      cursor: col-resize !important;
      user-select: none !important;
    }

    body.is-resizing * {
      user-select: none !important;
    }

    /* Collapsed Sidebar Rail Indicator */
    .sidebar-rail-indicator {
      display: none;
      flex-direction: column;
      align-items: center;
      height: 100%;
      padding-top: 10px;
      gap: 14px;
    }

    .portal-sidebar.collapsed .sidebar-rail-indicator {
      display: flex;
    }

    .rail-toggle-btn {
      width: 26px;
      height: 26px;
      border-radius: 4px;
      border: 1px solid var(--border-color);
      background: #FFFFFF;
      color: var(--text-secondary);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: 13px;
      transition: all 0.15s;
    }

    .rail-toggle-btn:hover {
      background: var(--primary-light);
      color: var(--primary);
      border-color: var(--primary);
    }

    .rail-vertical-text {
      writing-mode: vertical-rl;
      text-orientation: mixed;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.12em;
      color: var(--text-muted);
      user-select: none;
    }

    .sidebar-collapse-btn {
      border: 1px solid var(--border-color);
      background: #FFFFFF;
      color: var(--text-muted);
      cursor: pointer;
      font-size: 12px;
      padding: 2px 7px;
      border-radius: 4px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 600;
      transition: all 0.15s;
    }

    .sidebar-collapse-btn:hover {
      background: #F1F5F9;
      color: var(--text-primary);
      border-color: #CBD5E1;
    }
