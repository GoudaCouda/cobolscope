      <!-- Right Content Area: Viewer Pane -->
      <section class="portal-content">
        <div class="content-toolbar">
          <div class="prog-header-details">
            <span class="portal-brand-badge">COBOLSCOPE</span>
            <button id="btn-toggle-sidebar" class="tab-btn" onclick="toggleSidebar()" title="Toggle Program List Sidebar" style="padding:4px 8px; margin-right:8px;">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="9" y1="3" x2="9" y2="21"/></svg>
              <span>Programs</span>
            </button>
          </div>

          <div class="artifact-tab-group" id="artifact-tabs">
            <button id="tab-graph" class="tab-btn active" onclick="switchArtifact('call_graph')">Call Graph</button>
            <button id="tab-source" class="tab-btn" onclick="switchArtifact('source')">Source Code</button>
            <button id="tab-dict" class="tab-btn" onclick="switchArtifact('data_dictionary')">Data Dictionary</button>
          </div>

          <div class="content-actions">
            <a id="open-tab-btn" class="action-link" href="#" target="_blank" title="Open artifact in standalone browser tab">
              Open in New Tab
            </a>
          </div>
        </div>

        <div class="viewer-frame-container" id="viewer-frame-container">

          <!-- Single Pane View -->
          <div class="pane-view" id="single-pane-view">
            <!-- Blank Initial State: Enterprise Workbench Watermark & Quick Commands -->
            <div class="blank-state-container" id="blank-state-container">
              <div class="workbench-empty-view">
                <div class="workbench-empty-header">
                  <div class="workbench-watermark-tag">COBOL ANALYZER WORKBENCH</div>
                  <h2 class="workbench-empty-title">No Program Selected</h2>
                  <p class="workbench-empty-desc">Select a compilation unit from the sidebar to inspect procedure call graphs, data dictionaries, and synchronized source code.</p>
                </div>
                <div class="workbench-shortcuts-grid">
                  <div class="shortcut-item">
                    <span class="shortcut-keys"><kbd>/</kbd></span>
                    <span class="shortcut-label">Search programs by ID or routine</span>
                  </div>
                  <div class="shortcut-item">
                    <span class="shortcut-keys"><kbd>Alt</kbd> + <kbd>C</kbd></span>
                    <span class="shortcut-label">Toggle split source code view</span>
                  </div>
                  <div class="shortcut-item">
                    <span class="shortcut-keys"><kbd>Esc</kbd></span>
                    <span class="shortcut-label">Close inspectors or clear search filters</span>
                  </div>
                </div>
              </div>
            </div>

            <iframe id="content-frame" src="about:blank" style="display:none;"></iframe>

            <div class="source-container" id="source-container" style="display:none;">
              <div class="source-toolbar">
                <div class="source-title-area">
                  <code class="source-prog-title" id="sourceProgTitle"></code>
                </div>
                <div class="cobol-columns-indicator">
                  <span class="col-guide" title="Columns 1-6: Sequence Number">1-6</span>
                  <span class="col-guide" title="Column 7: Indicator Area">7</span>
                  <span class="col-guide" title="Columns 8-11: Area A">8-11 Area A</span>
                  <span class="col-guide" title="Columns 12-72: Area B">12-72 Area B</span>
                  <span class="col-guide" title="Columns 73-80: Identification">73-80</span>
                </div>
                <div class="source-search-box">
                  <input type="text" id="portal-source-search" placeholder="Jump to line / text..." onkeydown="onPortalSourceSearch(event)" />
                </div>
              </div>
              <div class="source-table-wrap">
                <table class="cobol-code-table" id="portal-source-table">
                  <tbody id="portal-source-tbody"></tbody>
                </table>
              </div>
            </div>

            <div class="message-container" id="message-container">
              <div class="message-card" id="message-card">
                <h3 id="message-title">Notice</h3>
                <p id="message-text">Please select a program from the sidebar to inspect its Call Graph, Source Code, or Data Dictionary.</p>
                <div class="error-trace" id="message-trace" style="display:none;"></div>
              </div>
            </div>
          </div>
        </div>
      </section>
