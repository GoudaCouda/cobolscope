    :root {
      --bg-primary: #F4F6F8;
      --bg-surface: #FFFFFF;
      --surface-hover: #ECEFF2;
      --border-color: #D3D9E0;
      --border-subtle: #E8ECEF;
      --text-primary: #1A202C;
      --text-secondary: #4A5568;
      --text-muted: #718096;
      --primary: #0056B3;
      --primary-hover: #004494;
      --primary-light: #EBF3FC;
      --primary-border: #BCD7F5;
      --success: #198754;
      --success-light: #E8F5E9;
      --warning: #B76E00;
      --warning-light: #FFF8E1;
      --danger: #C82333;
      --danger-light: #FDE8E8;
      --sidebar-width: 330px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background: var(--bg-primary);
      color: var(--text-primary);
      height: 100vh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    /* Unified Brand */
    .portal-brand-badge {
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 0.08em;
      color: var(--primary);
      padding-right: 8px;
      border-right: 1px solid var(--border-color);
      display: inline-flex;
      align-items: center;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .segmented-control {
      display: flex;
      background: var(--bg-primary);
      border: 1px solid var(--border-color);
      border-radius: 6px;
      padding: 2px;
      gap: 2px;
    }

    .segmented-btn {
      border: none;
      background: transparent;
      padding: 4px 10px;
      font-size: 12px;
      font-weight: 500;
      color: var(--text-secondary);
      border-radius: 4px;
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .segmented-btn:hover {
      color: var(--text-primary);
    }

    .segmented-btn.active {
      background: var(--bg-surface);
      color: var(--primary);
      font-weight: 600;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
    }

    /* Main Workspace Layout */
    .portal-main {
      flex: 1;
      display: flex;
      overflow: hidden;
      position: relative;
    }

    /* Left Sidebar */
    .portal-sidebar {
      width: var(--sidebar-width);
      background: var(--bg-primary);
      border-right: 1px solid var(--border-color);
      display: flex;
      flex-direction: column;
      flex-shrink: 0;
      overflow: hidden;
      position: relative;
      transition: width 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .portal-sidebar.collapsed {
      width: 36px !important;
      min-width: 36px !important;
      cursor: pointer;
      background: var(--bg-primary);
    }

    .portal-sidebar.collapsed .sidebar-header-row,
    .portal-sidebar.collapsed .sidebar-search-box,
    .portal-sidebar.collapsed .sidebar-filter-bar,
    .portal-sidebar.collapsed .program-list {
      display: none !important;
    }

    .sidebar-header-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
      padding: 8px 12px;
      background: var(--bg-surface);
      border-bottom: 1px solid var(--border-color);
    }

    .sidebar-header-title {
      font-size: 11px;
      font-weight: 700;
      color: var(--text-secondary);
      letter-spacing: 0.05em;
    }

    .sidebar-search-box {
      padding: 10px 12px;
      border-bottom: 1px solid var(--border-color);
      background: var(--bg-surface);
    }

    .search-input-wrapper {
      position: relative;
      display: flex;
      align-items: center;
    }

    .search-input-wrapper input {
      width: 100%;
      height: 32px;
      padding: 0 28px 0 10px;
      border: 1px solid var(--border-color);
      border-radius: 6px;
      font-size: 13px;
      color: var(--text-primary);
      background: var(--bg-primary);
      outline: none;
      transition: border-color 0.15s;
    }

    .search-input-wrapper input:focus {
      border-color: var(--primary);
      background: #FFFFFF;
    }

    .search-clear-btn {
      position: absolute;
      right: 8px;
      border: none;
      background: transparent;
      color: var(--text-muted);
      cursor: pointer;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 2px;
      border-radius: 3px;
      transition: color 0.1s, background-color 0.1s;
    }

    .search-clear-btn:hover {
      color: var(--text-primary);
      background: var(--surface-hover);
    }

    .sidebar-filter-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 8px 12px;
      font-size: 11px;
      color: var(--text-muted);
      background: var(--bg-primary);
      border-bottom: 1px solid var(--border-color);
    }

    .filter-tags {
      display: flex;
      gap: 4px;
    }

    .filter-chip {
      border: none;
      background: transparent;
      padding: 2px 6px;
      border-radius: 4px;
      font-size: 11px;
      color: var(--text-secondary);
      cursor: pointer;
      font-weight: 500;
    }

    .filter-chip.active {
      background: var(--border-color);
      color: var(--text-primary);
      font-weight: 600;
    }

    .program-list {
      flex: 1;
      overflow-y: auto;
      padding: 4px 0;
    }

    .program-item {
      padding: 9px 14px;
      display: flex;
      flex-direction: column;
      gap: 3px;
      border-left: 3px solid transparent;
      cursor: pointer;
      transition: background 0.1s;
      border-bottom: 1px solid rgba(226, 232, 240, 0.4);
    }

    .program-item:hover {
      background: #F1F5F9;
    }

    .program-item.active {
      background: var(--primary-light);
      border-left-color: var(--primary);
    }

    .program-item-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .program-id {
      font-size: 13px;
      font-weight: 700;
      color: var(--text-primary);
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    }

    .program-item.active .program-id {
      color: var(--primary);
    }

    .program-file {
      font-size: 11px;
      color: var(--text-secondary);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .program-meta-row {
      display: flex;
      align-items: center;
      gap: 6px;
      margin-top: 2px;
    }

    .badge {
      font-size: 10px;
      padding: 1px 5px;
      border-radius: 3px;
      font-weight: 500;
      border: 1px solid transparent;
    }

    .badge-metric {
      background: #FFFFFF;
      border-color: var(--border-color);
      color: var(--text-secondary);
    }

    .badge-artifact {
      background: var(--surface-hover);
      color: var(--text-secondary);
    }

    .badge-status-ok {
      color: var(--success);
    }

    .badge-status-fail {
      color: var(--danger);
      background: var(--danger-light);
      border-color: rgba(220, 38, 38, 0.2);
    }

    /* Right Viewer Content Area */
    .portal-content {
      flex: 1;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      background: var(--bg-surface);
    }

    .content-toolbar {
      height: 48px;
      background: var(--bg-surface);
      border-bottom: 1px solid var(--border-color);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 16px;
      flex-shrink: 0;
    }

    .prog-header-details {
      display: flex;
      align-items: center;
      gap: 12px;
      min-width: 0;
    }

    .prog-title {
      font-size: 15px;
      font-weight: 700;
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      color: var(--text-primary);
    }

    .prog-header-chips {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .chip {
      font-size: 11px;
      background: var(--bg-primary);
      border: 1px solid var(--border-color);
      color: var(--text-secondary);
      padding: 2px 7px;
      border-radius: 4px;
    }

    .artifact-tab-group {
      display: flex;
      align-items: center;
      gap: 4px;
      background: var(--bg-primary);
      border: 1px solid var(--border-color);
      padding: 2px;
      border-radius: 6px;
    }

    .tab-btn {
      border: none;
      background: transparent;
      padding: 5px 12px;
      font-size: 12px;
      font-weight: 600;
      color: var(--text-secondary);
      border-radius: 4px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.1s ease;
    }

    .tab-btn:hover:not(:disabled) {
      color: var(--text-primary);
    }

    .tab-btn.active {
      background: var(--bg-surface);
      color: var(--primary);
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
    }

    .tab-btn:disabled {
      opacity: 0.4;
      cursor: not-allowed;
    }

    .content-actions {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .action-link {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 12px;
      font-weight: 500;
      color: var(--primary);
      text-decoration: none;
      padding: 4px 8px;
      border-radius: 4px;
      border: 1px solid var(--primary-border);
      background: var(--primary-light);
      transition: background 0.15s;
    }

    .action-link:hover {
      background: var(--primary-border);
    }

    .viewer-frame-container {
      flex: 1;
      position: relative;
      background: #FFFFFF;
      overflow: hidden;
    }

    .pane-view {
      display: flex;
      width: 100%;
      height: 100%;
      position: relative;
      overflow: hidden;
    }

    iframe#content-frame {
      width: 100%;
      height: 100%;
      border: none;
      display: block;
      background: #FFFFFF;
    }

    /* Blank Initial State Container: Integrated Workbench Cue */
    .blank-state-container {
      display: flex;
      flex-direction: column;
      height: 100%;
      width: 100%;
      align-items: center;
      justify-content: center;
      padding: 48px 24px;
      background: var(--bg-primary);
      user-select: none;
    }

    .workbench-empty-view {
      max-width: 480px;
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 24px;
    }

    .workbench-empty-header {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
    }

    .workbench-watermark-tag {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--text-muted);
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      padding: 2px 8px;
      background: var(--bg-surface);
      border: 1px solid var(--border-color);
      border-radius: 3px;
    }

    .workbench-empty-title {
      font-size: 16px;
      font-weight: 600;
      color: var(--text-primary);
      margin: 4px 0 0;
      letter-spacing: -0.01em;
    }

    .workbench-empty-desc {
      font-size: 13px;
      color: var(--text-secondary);
      line-height: 1.5;
      max-width: 400px;
      margin: 0;
    }

    .workbench-shortcuts-grid {
      display: flex;
      flex-direction: column;
      gap: 8px;
      width: 100%;
      max-width: 360px;
      padding: 12px 16px;
      background: var(--bg-surface);
      border: 1px solid var(--border-color);
      border-radius: 4px;
    }

    .shortcut-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 12px;
      gap: 12px;
      padding: 3px 0;
    }

    .shortcut-keys {
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    .shortcut-keys kbd {
      display: inline-block;
      padding: 2px 6px;
      font-size: 11px;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-weight: 600;
      line-height: 1.2;
      color: var(--text-primary);
      background: var(--bg-primary);
      border: 1px solid var(--border-color);
      border-radius: 3px;
      box-shadow: 0 1px 0 rgba(0, 0, 0, 0.08);
    }

    .shortcut-label {
      color: var(--text-secondary);
      text-align: right;
    }

    /* Fallback / Error Message Container */
    .message-container {
      display: none;
      height: 100%;
      align-items: center;
      justify-content: center;
      padding: 40px;
      text-align: center;
      background: var(--bg-primary);
    }

    .message-card {
      max-width: 580px;
      background: #FFFFFF;
      border: 1px solid var(--border-color);
      border-radius: 8px;
      padding: 32px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
      text-align: left;
    }

    .message-card h3 {
      font-size: 16px;
      font-weight: 700;
      margin-bottom: 8px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .message-card.error h3 { color: var(--danger); }
    .message-card.info h3 { color: var(--text-primary); }

    .message-card p {
      font-size: 13px;
      color: var(--text-secondary);
      line-height: 1.5;
      margin-bottom: 12px;
    }

    .error-trace {
      background: #111827;
      color: #F3F4F6;
      padding: 12px;
      border-radius: 6px;
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      font-size: 12px;
      white-space: pre-wrap;
      word-break: break-all;
      max-height: 240px;
      overflow-y: auto;
      margin-top: 12px;
    }
