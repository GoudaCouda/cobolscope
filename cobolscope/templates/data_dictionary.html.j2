<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Data Dictionary - {{ program.program_id }}</title>
    <style>
        :root {
            --bg: #0f172a;
            --surface: #1e293b;
            --surface-hover: #334155;
            --border: #334155;
            --primary: #38bdf8;
            --primary-bg: rgba(56, 189, 248, 0.1);
            --text: #f8fafc;
            --text-muted: #94a3b8;
            --badge-redef: #f59e0b;
            --badge-occurs: #8b5cf6;
            --badge-val: #10b981;
            --accent: #6366f1;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background-color: var(--bg);
            color: var(--text);
            line-height: 1.5;
            padding: 2rem;
        }
        .container { max-width: 1400px; margin: 0 auto; }
        .header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 2rem;
            padding-bottom: 1.5rem;
            border-bottom: 1px solid var(--border);
        }
        h1 { font-size: 2rem; font-weight: 700; color: var(--primary); }
        .meta-text { color: var(--text-muted); font-size: 0.9rem; margin-top: 0.25rem; }
        
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 1rem;
            margin-bottom: 2rem;
        }
        .stat-card {
            background-color: var(--surface);
            border: 1px solid var(--border);
            border-radius: 0.5rem;
            padding: 1.25rem;
        }
        .stat-title { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); }
        .stat-value { font-size: 1.75rem; font-weight: 700; color: var(--text); margin-top: 0.25rem; }

        .toolbar {
            display: flex;
            gap: 1rem;
            margin-bottom: 1rem;
            flex-wrap: wrap;
        }
        .search-box {
            flex: 1;
            min-width: 300px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 0.375rem;
            padding: 0.625rem 1rem;
            color: var(--text);
            font-size: 0.95rem;
        }
        .search-box:focus { outline: 2px solid var(--primary); border-color: transparent; }
        
        .filter-select {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 0.375rem;
            padding: 0.625rem 1rem;
            color: var(--text);
            font-size: 0.95rem;
        }

        .table-container {
            background-color: var(--surface);
            border: 1px solid var(--border);
            border-radius: 0.5rem;
            overflow-x: auto;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
            font-size: 0.9rem;
        }
        th {
            background-color: rgba(15, 23, 42, 0.6);
            color: var(--text-muted);
            font-weight: 600;
            padding: 0.875rem 1rem;
            border-bottom: 1px solid var(--border);
            cursor: pointer;
            user-select: none;
        }
        th:hover { color: var(--primary); }
        td {
            padding: 0.875rem 1rem;
            border-bottom: 1px solid var(--border);
            vertical-align: middle;
        }
        tr:hover { background-color: var(--surface-hover); }
        .filler-row { opacity: 0.65; }

        .font-mono { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; }
        .text-center { text-align: center; }
        .text-sm { font-size: 0.8rem; }
        .text-muted { color: var(--text-muted); }

        .field-name { font-weight: 600; color: var(--text); }
        .field-path { font-size: 0.75rem; margin-top: 0.15rem; }

        .badge {
            display: inline-block;
            font-size: 0.7rem;
            font-weight: 600;
            padding: 0.15rem 0.4rem;
            border-radius: 0.25rem;
            margin-left: 0.4rem;
            vertical-align: middle;
        }
        .badge-redefines { background: rgba(245, 158, 11, 0.15); color: var(--badge-redef); border: 1px solid rgba(245, 158, 11, 0.3); }
        .badge-occurs { background: rgba(139, 92, 246, 0.15); color: var(--badge-occurs); border: 1px solid rgba(139, 92, 246, 0.3); }
        .badge-value { background: rgba(16, 185, 129, 0.15); color: var(--badge-val); border: 1px solid rgba(16, 185, 129, 0.3); }
        
        .type-pill {
            background-color: var(--primary-bg);
            color: var(--primary);
            padding: 0.2rem 0.5rem;
            border-radius: 0.25rem;
            font-size: 0.8rem;
            font-weight: 500;
            display: inline-block;
        }

        .cond88-block {
            margin-top: 0.4rem;
            padding-left: 0.5rem;
            border-left: 2px solid var(--accent);
            font-size: 0.8rem;
            color: #cbd5e1;
        }
        .cond88-item { margin-top: 0.15rem; }

        .refs-list { display: flex; flex-wrap: wrap; gap: 0.25rem; }
        .ref-tag {
            background: #334155;
            color: #e2e8f0;
            padding: 0.1rem 0.4rem;
            border-radius: 0.2rem;
            font-size: 0.75rem;
            font-family: ui-monospace, SFMono-Regular, monospace;
        }
    </style>
</head>
<body>
    <div class="container">
        <header class="header">
            <div>
                <h1>Data Dictionary: {{ program.program_id }}</h1>
                <div class="meta-text">Source: <span class="font-mono">{{ program.source_file_path }}</span></div>
            </div>
            {% if program.date_written or program.author %}
            <div class="meta-text text-right">
                {% if program.author %}<div>Author: {{ program.author }}</div>{% endif %}
                {% if program.date_written %}<div>Date Written: {{ program.date_written }}</div>{% endif %}
            </div>
            {% endif %}
        </header>

        <section class="stats-grid">
            <div class="stat-card">
                <div class="stat-title">Total Data Items</div>
                <div class="stat-value font-mono">{{ summary.total_fields }}</div>
            </div>
            <div class="stat-card">
                <div class="stat-title">Level-88 Rules</div>
                <div class="stat-value font-mono">{{ summary.total_88s }}</div>
            </div>
            <div class="stat-card">
                <div class="stat-title">Memory Overlays</div>
                <div class="stat-value font-mono">{{ summary.total_redefines }}</div>
            </div>
            <div class="stat-card">
                <div class="stat-title">Working-Storage Span</div>
                <div class="stat-value font-mono">{{ summary.ws_bytes | format_bytes }}</div>
            </div>
        </section>

        <div class="toolbar">
            <input type="text" id="searchInput" class="search-box" placeholder="Search fields, qualified paths, or referencing paragraphs...">
            <select id="sectionFilter" class="filter-select">
                <option value="ALL">All Sections</option>
                {% for sec in available_sections %}
                <option value="{{ sec }}">{{ sec }}</option>
                {% endfor %}
            </select>
            <select id="typeFilter" class="filter-select">
                <option value="ALL">All Types</option>
                {% for t in available_types %}
                <option value="{{ t }}">{{ t }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="table-container">
            <table id="dictTable">
                <thead>
                    <tr>
                        <th onclick="sortTable(0)" class="text-center" style="width: 70px;">Lvl</th>
                        <th onclick="sortTable(1)">Field Name / Structure</th>
                        <th onclick="sortTable(2)">Business Type</th>
                        <th onclick="sortTable(3)">PIC / Usage</th>
                        <th onclick="sortTable(4)" class="text-center">Offset</th>
                        <th onclick="sortTable(5)" class="text-center">Length</th>
                        <th>Where-Used (Paragraphs)</th>
                    </tr>
                </thead>
                <tbody id="dictTableBody">
                    {% for r in rows %}
                    <tr class="{% if r.is_filler %}filler-row{% endif %}" data-section="{{ r.section }}" data-name="{{ r.name | upper }}" data-path="{{ r.qualified_name | upper }}" data-type="{{ r.logical_type }}">
                        <td class="text-center font-mono"><b>{{ "%02d" | format(r.level) }}</b></td>
                        <td>
                            <div style="padding-left: {{ r.depth * 18 }}px;">
                                <span class="field-name font-mono">{{ r.name }}</span>
                                {% if r.redefines %}<span class="badge badge-redefines">REDEFINES {{ r.redefines }}</span>{% endif %}
                                {% if r.occurs_str %}<span class="badge badge-occurs">OCCURS {{ r.occurs_str }}</span>{% endif %}
                                {% if r.value %}<span class="badge badge-value">VALUE {{ r.value }}</span>{% endif %}
                                <div class="field-path font-mono text-muted">{{ r.qualified_name }}</div>
                                {% if r.conditions_88 %}
                                <div class="cond88-block">
                                    {% for c in r.conditions_88 %}
                                    <div class="cond88-item"><b>88 {{ c['name'] }}:</b> {{ c['values'] | join(', ') }}</div>
                                    {% endfor %}
                                </div>
                                {% endif %}
                            </div>
                        </td>
                        <td><span class="type-pill">{{ r.logical_type }}</span></td>
                        <td class="font-mono text-sm">{{ r.pic or '—' }}<br/><span class="text-muted">{{ r.usage }}</span></td>
                        <td class="text-center font-mono">{{ r.byte_offset }}</td>
                        <td class="text-center font-mono"><b>{{ r.byte_length }}</b></td>
                        <td>
                            {% if r.references %}
                            <div class="refs-list">
                                {% for ref in r.references %}
                                <span class="ref-tag">{{ ref }}</span>
                                {% endfor %}
                            </div>
                            {% else %}
                            <span class="text-muted">—</span>
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <script>
        const searchInput = document.getElementById('searchInput');
        const sectionFilter = document.getElementById('sectionFilter');
        const typeFilter = document.getElementById('typeFilter');
        const rows = document.querySelectorAll('#dictTable tbody tr');

        function filterRows() {
            const query = searchInput.value.toLowerCase().trim();
            const sec = sectionFilter.value;
            const typ = typeFilter.value;

            rows.forEach(r => {
                const text = r.textContent.toLowerCase();
                const rSec = r.getAttribute('data-section');
                const rTyp = r.getAttribute('data-type');

                const matchQuery = !query || text.includes(query);
                const matchSec = sec === 'ALL' || rSec === sec;
                const matchTyp = typ === 'ALL' || rTyp === typ;

                r.style.display = (matchQuery && matchSec && matchTyp) ? '' : 'none';
            });
        }

        searchInput.addEventListener('input', filterRows);
        sectionFilter.addEventListener('change', filterRows);
        typeFilter.addEventListener('change', filterRows);

        function sortTable(n) {
            const table = document.getElementById("dictTable");
            let rows, switching = true, i, x, y, shouldSwitch, dir = "asc", switchcount = 0;
            
            while (switching) {
                switching = false;
                rows = table.rows;
                for (i = 1; i < (rows.length - 1); i++) {
                    shouldSwitch = false;
                    x = rows[i].getElementsByTagName("TD")[n];
                    y = rows[i + 1].getElementsByTagName("TD")[n];
                    
                    let xVal = x.textContent.trim();
                    let yVal = y.textContent.trim();

                    // Check if numeric
                    let xNum = parseFloat(xVal.replace(/[^0-9.-]+/g,""));
                    let yNum = parseFloat(yVal.replace(/[^0-9.-]+/g,""));

                    let cmpX = isNaN(xNum) ? xVal.toLowerCase() : xNum;
                    let cmpY = isNaN(yNum) ? yVal.toLowerCase() : yNum;

                    if (dir == "asc") {
                        if (cmpX > cmpY) { shouldSwitch = true; break; }
                    } else if (dir == "desc") {
                        if (cmpX < cmpY) { shouldSwitch = true; break; }
                    }
                }
                if (shouldSwitch) {
                    rows[i].parentNode.insertBefore(rows[i + 1], rows[i]);
                    switching = true;
                    switchcount++;
                } else {
                    if (switchcount == 0 && dir == "asc") {
                        dir = "desc";
                        switching = true;
                    }
                }
            }
        }
    </script>
</body>
</html>
